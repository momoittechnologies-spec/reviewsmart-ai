datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── USER ─────────────────────────────────────────────────────────────────────
model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  password       String
  userIdTag      String?           @unique // Mobile number for merchants, Agent code for agents (e.g. MKT-01)
  pinCode        String?           // Hashed 4-digit numeric PIN (bcrypt)
  phone          String?
  role           String            @default("BUSINESS_OWNER") // "SUPER_ADMIN" | "BUSINESS_OWNER" | "MARKETING_AGENT"
  agentCode      String?           // Unique code for marketing agents (e.g. MKT-01)
  commissionRate Float?            // Individual agent commission rate (e.g. 0.30 for 30%, 0.40 for 40%). Falls back to platform setting if null
  referredBy     String?           // Agent user ID who onboarded this merchant
  customerType   String            @default("OFFLINE") // "ONLINE" (admin direct) | "OFFLINE" (agent field sale)
  isActive       Boolean           @default(true) // Admin can disable/suspend accounts
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  businesses     Business[]
  subscription   UserSubscription?  // Kept for backward compat — not shown in UI
  upiPayments    UpiPayment[]
}

// ─── SUBSCRIPTION (kept in DB for backward compat — hidden from UI) ───────────
model SubscriptionPlan {
  id            String             @id @default(cuid())
  name          String
  price         Float              @default(0)
  currency      String             @default("INR")
  durationDays  Int                @default(365)
  maxCards      Int                @default(1)
  features      String             @default("[\"AI Review Generation\",\"Negative Review Shield\",\"Smart QR Code\"]")
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions UserSubscription[]
}

model UserSubscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  planId    String
  status    String           @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "CANCELLED"
  startDate DateTime         @default(now())
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
}

// ─── BUSINESS ─────────────────────────────────────────────────────────────────
model Business {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  slug               String            @unique
  tagline            String?           @default("Review our service & share your experience!")
  category           String?           @default("Local Business")
  customerType       String            @default("OFFLINE") // "ONLINE" | "OFFLINE"
  logoUrl            String?
  primaryColor       String            @default("#4f46e5")
  googlePlaceId      String?
  googleReviewUrl    String?
  googleMapsUrl      String?
  googleAddress      String?
  phone              String?
  whatsapp           String?
  instagram          String?
  facebook           String?
  website            String?
  minRatingForGoogle Int               @default(4)
  keywords           String            @default("exceptional service, highly recommended, friendly staff, prompt delivery, great experience")
  tagChips           String            @default("Friendly Staff,Fast Service,Great Quality,Fair Pricing,Clean Ambiance")
  reviewPromptTone   String            @default("friendly")
  qrMode             String            @default("SMART_HUB") // "SMART_HUB" | "REVIEW_BOOSTER"
  menuUrl            String?
  customUpiId        String?
  // Modular Feature Toggles (Flexible Per-Merchant Configuration)
  enableUpiPayments       Boolean           @default(true)
  enableScratchCard       Boolean           @default(false)
  scratchCardMaxDiscount  Int               @default(5)
  enableSocialLinks       Boolean           @default(true)
  enableDigitalMenu       Boolean           @default(true)
  packageTier        String            @default("EXECUTIVE_STANDEE") // "STARTER_PVC" | "EXECUTIVE_STANDEE" | "ALL_IN_ONE_HUB" | "ENTERPRISE_CUSTOM"
  visitingCardBackMode String?         @default("BUSINESS_CARD") // "BUSINESS_CARD" | "CUSTOM_IMAGE" | "DUAL_UPI" | "GUIDE"
  visitingCardOwnerName String?
  visitingCardOwnerTitle String?
  visitingCardPhone    String?
  visitingCardEmail    String?
  visitingCardAddress  String?
  visitingCardImageUrl String?
  isPaid             Boolean           @default(false) // false until admin explicitly approves payment
  gmbStatus          String            @default("NOT_REQUESTED") // "NOT_REQUESTED" | "DETAILS_SUBMITTED" | "IN_PROGRESS" | "VERIFICATION_PENDING" | "VERIFIED_LIVE"
  gmbNotes           String?           // Super Admin or Agent notes on GMB optimization & verification
  demoExpiresAt      DateTime?         // If set and in future, card is temporarily active for evaluation
  demoActivatedAt    DateTime?         // Timestamp when demo was started
  demoActivatedBy    String?           // User ID of agent or admin who activated the demo
  demoUsed           Boolean           @default(false) // Guardrail: prevents repeated free demo abuse
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks          PrivateFeedback[]
  analytics          ReviewAnalytics[]
  reviewMemories     GeneratedReviewMemory[]
}

// ─── PRIVATE FEEDBACK (negative review intercept) ─────────────────────────────
model PrivateFeedback {
  id            String   @id @default(cuid())
  businessId    String
  rating        Int
  customerName  String?
  customerEmail String?
  customerPhone String?
  comments      String
  status        String   @default("NEW") // "NEW" | "CONTACTED" | "RESOLVED"
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── REVIEW ANALYTICS ─────────────────────────────────────────────────────────
model ReviewAnalytics {
  id         String   @id @default(cuid())
  businessId String
  eventType  String   // "PAGE_VIEW" | "STAR_SELECTED" | "AI_GENERATED" | "GOOGLE_REDIRECT" | "FEEDBACK_SUBMITTED"
  rating     Int?
  deviceType String?  // "mobile" | "desktop"
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── UPI PAYMENT ──────────────────────────────────────────────────────────────
model UpiPayment {
  id             String   @id @default(cuid())
  userId         String
  businessId     String?
  agentId        String?  // Agent user ID who closed the offline deal
  agentCode      String?  // e.g. "MKT-01"
  planType       String   @default("NEGOTIATED_DEAL") // "NEGOTIATED_DEAL" | "ONLINE_DIRECT"
  amount         Float    @default(2999)
  utrNumber      String   // 12-digit UPI reference number submitted by customer/agent
  customerPhone  String?
  status         String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  commission     Float?   // Auto-calculated: 40% of amount for agent deals (on approval)
  commissionPaid Boolean  @default(false)
  packageTier    String?  @default("EXECUTIVE_STANDEE") // "STARTER_PVC" | "EXECUTIVE_STANDEE" | "ALL_IN_ONE_HUB" | "ENTERPRISE_CUSTOM"
  screenshotUrl  String?  // Base64 or uploaded URL of payment screenshot/receipt
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── PLATFORM SETTINGS ────────────────────────────────────────────────────────
model PlatformSetting {
  id                 String   @id @default("default")
  platformName       String   @default("ReviewSmart AI")
  supportEmail       String   @default("support@reviewsmart.online")
  supportWhatsapp    String   @default("+918639831132")
  customDomain       String?
  currencySymbol     String   @default("₹")
  upiId              String   @default("9036909110@apl")
  upiPayeeName       String   @default("Damerla Mohan")
  minNegotiatedPrice Float    @default(2999)   // Hard floor for all agent + online deals
  commissionRate     Float    @default(0.30)  // 30% default agent commission on verified sales
  updatedAt          DateTime @updatedAt
}

// ─── GENERATED REVIEW MEMORY (Zero-Duplicate Engine) ──────────────────────────
model GeneratedReviewMemory {
  id                  String   @id @default(cuid())
  businessId          String?
  businessName        String
  category            String?
  reviewText          String
  openingPhrase       String   // lowercased first 4-6 words normalized
  closingPhrase       String   // lowercased last 4-6 words normalized
  structureTag        String   // "STRUCTURE_A", "STRUCTURE_B", "SHORT_CASUAL", etc.
  writingStyle        String   // "short_casual", "detailed_helpful", "enthusiastic", "story_like", "minimal", etc.
  languageMix         String   // "ENGLISH", "TELUGU_SCRIPT", "TELUGU_ENGLISH", "TELUGU_ROMAN"
  tagsUsed            String?  // comma-separated tags or chips
  ngramHash           String?  // token-level fingerprint for fast set-intersection similarity
  createdAt           DateTime @default(now())

  business            Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([openingPhrase])
  @@index([structureTag])
  @@index([createdAt])
}


// ─── FIELD SALES & CRM LEAD CAPTURE ──────────────────────────────────────────
model LeadCapture {
  id                 String         @id @default(cuid())
  businessName       String
  city               String?
  locality           String?        // Branch / locality / area (e.g. "Ganagapeta", "YV Street")
  category           String?
  phone              String?        // Nullable: genuine null when phone not available yet
  source             String         @default("WEBSITE_ENQUIRY") // "WEBSITE_ENQUIRY" | "RADAR_DISCOVERY" | "CSV_IMPORT" | "FIELD_VISIT" | "HERO_CUSTOMIZER"
  notes              String?
  status             String         @default("NEW")            // "NEW" | "CONTACTED" | "DEMO_REQUESTED" | "CONVERTED" | "LOST"
  
  // Structured Provider & Verification Details
  provider           String?        // "OPENSTREETMAP" | "GOOGLE_PLACES" | "MANUAL" | "CSV_IMPORT" | "WEBSITE_ENQUIRY"
  providerListingId  String?        // ID from source provider
  listingUrl         String?        // Maps or business URL
  rating             Float?         // Structured rating (null if unverified)
  reviewCount        Int?           // Structured count (genuine 0 preserved, null if unknown)
  observedDate       DateTime?      // When rating/count was observed
  verificationMethod String         @default("UNVERIFIED") // "API_VERIFIED" | "MAPS_LINK_ONLY" | "UNVERIFIED" | "FIELD_VERIFIED" | "USER_SUBMITTED"

  // Priority & Action Management
  priority           String         @default("NEEDS_VERIFICATION") // "NEEDS_VERIFICATION" | "DEMO_REQUESTED" | "FOLLOW_UP_TODAY" | "BELOW_THRESHOLD" | "NORMAL"
  priorityReason     String?        // Explicit reason (e.g. "Demo requested", "Follow-up due today", "Verified count below 100")
  assignedAgentId    String?
  assignedAgentName  String?
  nextAction         String?        // "CALL" | "IN_PERSON_VISIT" | "WHATSAPP_FOLLOWUP" | "DELIVER_MOCKUP"
  nextActionDue      DateTime?
  lastOutcome        String?        // "SPOKE_TO_OWNER" | "NO_ANSWER" | "CALLBACK_REQUESTED" | "VISITED_STORE" | "NOT_INTERESTED"
  doNotContact       Boolean        @default(false)
  confirmedPaidAt    DateTime?      // Admin-verified payment conversion timestamp

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  activities         LeadActivity[]

  @@index([phone])
  @@index([status])
  @@index([priority])
  @@index([nextActionDue])
  @@index([assignedAgentId])
  @@index([createdAt])
}

// ─── LEAD ACTIVITY AUDIT TRAIL ────────────────────────────────────────────────
model LeadActivity {
  id          String      @id @default(cuid())
  leadId      String
  type        String      // "CALL" | "WHATSAPP_DRAFT" | "WHATSAPP_SENT" | "IN_PERSON_VISIT" | "NOTE" | "STATUS_CHANGE" | "ASSIGNMENT"
  outcome     String?     // "SPOKE_TO_OWNER" | "NO_ANSWER" | "CALLBACK_REQUESTED" | "DRAFT_OPENED" | "SENT_CONFIRMED" | "VISITED_STORE"
  notes       String?
  performedBy String?     // Agent name or user identifier
  createdAt   DateTime    @default(now())

  lead        LeadCapture @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}
